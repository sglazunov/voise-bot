# This project runs on Linux — keep LF endings so shell scripts and the
# Dockerfile work regardless of the OS the commit was made on.
* text=auto eol=lf
*.py    text eol=lf
*.sh    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.html  text eol=lf
*.json  text eol=lf
*.service text eol=lf
Dockerfile text eol=lf
Modelfile  text eol=lf
.env.example text eol=lf
.dockerignore text eol=lf
.gitignore text eol=lf
