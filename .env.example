# Copy to .env and edit. Everything has a sane default — you only need keys for
# the features you use. Recognition works with no keys at all.

# --- Web ---
APP_PORT=8000
# К какому адресу привязать порт приложения. 0.0.0.0 — доступен из интернета
# (нужно, пока нет домена). Когда поднят HTTPS через Caddy, поставьте
# 127.0.0.1: прокси ходит к приложению по внутренней сети, а порт исчезает из
# интернета. ufw тут не поможет — правила Docker в iptables идут раньше него.
APP_BIND=0.0.0.0

# --- Recognition (faster-whisper, CPU) ---
# Model size vs speed/RAM: small (~1 GB) | medium (~1.5 GB) | large-v3 (~3 GB)
VTX_MODEL=small
VTX_COMPUTE_TYPE=int8
VTX_CPU_THREADS=4
VTX_BEAM_SIZE=5
VTX_LANGUAGE=ru

# --- Protocol engine (pick one path) ---
# A) Ollama — free, local, but NOT installed on the server: connect an EXTERNAL one.
#    Ollama has no API key (it's a keyless HTTP server). Install it on the host or
#    another machine, start it with OLLAMA_HOST=0.0.0.0, then point OLLAMA_URL here.
#    Default already targets the Docker host; change it for another server.
OLLAMA_URL=http://host.docker.internal:11434
# OLLAMA_URL=http://192.168.1.50:11434
VTX_OLLAMA_MODEL=qwen2.5:7b
# B) Cloud by key (leave blank if unused):
GROQ_API_KEY=
# NVIDIA NIM — бесплатно и без карты: ключ `nvapi-…` с
# build.nvidia.com/settings/api-keys. Даёт Kimi, DeepSeek, Qwen, Llama, Nemotron
# и ещё сотню открытых моделей; список подтягивается по ключу и виден в
# выпадающем списке движков. Лимит ~40 запросов в минуту на ключ И на все модели
# сразу — на длинной встрече может упереться, тогда добавьте второй ключ в
# интерфейсе (они чередуются).
NVIDIA_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
GIGACHAT_AUTH_KEY=

# Anti-hallucination filters: drop a segment Whisper itself flags as probable
# silence (no_speech_prob) decoded with low confidence (avg_logprob); collapse
# runs of N identical consecutive segments (looping on silence).
#VTX_NS_PROB_MAX=0.6
#VTX_LOGPROB_MIN=-1.0
#VTX_REPEAT_COLLAPSE_AT=3

# Ollama context-window ceiling; the app sizes each request's num_ctx up to it.
#VTX_OLLAMA_NUM_CTX=32768

# --- Diarization ("who spoke") — heavy; needs image rebuild with pyannote+torch ---
# ВАЖНО: включает диаризацию именно DIARIZATION — это build-arg, и docker-compose
# передаёт его в environment, ПЕРЕКРЫВАЯ VTX_DIARIZATION из этого файла. Ставить
# 1 нужно здесь и пересобирать образ (torch+pyannote, ~2.5 ГБ).
DIARIZATION=0
VTX_DIARIZATION=0
HF_TOKEN=

# --- Meeting recorder bot (Telemost) ---
# 1 = bot joins Telemost in a virtual display and records (Xvfb + PulseAudio).
# Weeek token, cloud and bot options are set in the UI (/automation), saved to /data.
VTX_RECORDER_ENABLED=1
# How many meetings can be recorded IN PARALLEL (each isolated on its own virtual
# display + audio sink). Overlapping meetings record at once, up to this many.
# Each parallel recording ≈ a Chromium + ffmpeg (CPU + ~0.5 GB RAM) — size the VM.
# Выход по тишине: сколько секунд тишины ПОСЛЕ начавшегося разговора считать
# концом встречи. Признаки «все вышли» читаются из вёрстки Телемоста, и когда
# она их не отдаёт, бот пишет пустую комнату до максимальной длины (на бою так
# вышли две записи по 4 часа). Тишина от вёрстки не зависит. 0 — выключить.
VTX_END_ON_SILENCE_SEC=600
VTX_MAX_CONCURRENT_RECORDINGS=4
VTX_SCREEN_RES=1920x1080x24

# --- Security / accounts (see docs/БЕЗОПАСНОСТЬ.md) ---
# Master key for encrypting users' tokens at rest. SET YOUR OWN long random value
# in production and keep it out of git. If empty, a key is generated in data/secret.key.
VTX_SECRET_KEY=
# Registration is ALWAYS open: without an invite code a new account gets its own
# empty team; with a team-admin's invite code (shown in their Profile, rotates
# daily) it joins that team. To forbid new sign-ups entirely, gate the site at
# the proxy/VPN level — there is no in-app switch yet.
# ---- Домен и HTTPS -----------------------------------------------------------
# Заполните три строки ниже — Caddy сам получит сертификат Let's Encrypt и будет
# продлевать его в фоне. Пока DOMAIN пуст, сервис работает по http://IP:8000.
# ЗАРАНЕЕ обязательно: A-запись домена → IP сервера и открытые порты 80 и 443
# (в firewall И в группе безопасности ВМ) — Let's Encrypt проверяет домен по 80.
DOMAIN=
ACME_EMAIL=
# Включает сервис caddy при обычном `docker compose up -d`; иначе пришлось бы
# каждый раз дописывать --profile https.
COMPOSE_PROFILES=

# Session lifetime (hours) and Secure-cookie flag (set 1 when behind HTTPS).
VTX_SESSION_TTL_HOURS=168
VTX_HTTPS=0
# Behind a reverse proxy set 1 so rate limiting sees the real client IP
# (X-Forwarded-For). NEVER set it without a proxy — clients could spoof the IP.
VTX_TRUST_PROXY=0
# Brute-force window: this many failed logins per window (sec) per IP → 429.
VTX_LOGIN_MAX_ATTEMPTS=8
VTX_LOGIN_WINDOW_SEC=900
# Team invite code lifetime (sec); a fresh code is minted after it expires.
VTX_INVITE_CODE_TTL_SEC=86400

# --- Password recovery by SMS (one-time code to the registered phone) ---
# Provider is auto-selected: SMS.ru once VTX_SMSRU_API_ID is set, otherwise a
# "console" fallback that only logs the code (dev / before a gateway is set up).
# Get api_id at https://sms.ru/#api . Leave empty to keep the console fallback.
VTX_SMSRU_API_ID=
# Optional approved sender name, and a no-charge test mode (1 = don't really send).
VTX_SMSRU_FROM=
VTX_SMSRU_TEST=0
# Force a provider explicitly (smsru | console); empty = auto-detect from api_id.
VTX_SMS_PROVIDER=
# Code lifetime, max wrong attempts before it burns, and resend cooldown (sec).
VTX_RECOVERY_CODE_TTL_SEC=600
VTX_RECOVERY_MAX_ATTEMPTS=5
VTX_RECOVERY_RESEND_SEC=60

# --- Storage backend (PostgreSQL) ---
# When DATABASE_URL is set, structured state (users, sessions, jobs, settings,
# LLM keys, meeting states, AI context) lives in PostgreSQL; media files still
# go to ./data. Empty = keep the JSON-file backend (simple local runs / tests).
# docker-compose brings up a `db` service; these creds must match it.
DATABASE_URL=postgresql://voise:voise@db:5432/voise
POSTGRES_USER=voise
POSTGRES_PASSWORD=voise
POSTGRES_DB=voise

# --- Misc ---
TZ=Europe/Moscow
VTX_RETENTION_HOURS=24

# --- Движки протокола: порядок и тонкая настройка --------------------------
# «Авто» берёт первый НАСТРОЕННЫЙ движок из этого списка. Порядок по замерам на
# боевых встречах: DeepSeek через NVIDIA даёт самый полный протокол, Gemini —
# устойчивый запасной, Groq заметно хуже (дробит темы, теряет задачи).
VTX_PROVIDER_ORDER=nvidia,gemini,groq,yandex,gigachat,anthropic,ollama
# Ollama в образ не входит: это ВНЕШНИЙ сервер. Включать, только если он есть,
# иначе движок числится доступным и задачи падают на попытке подключения.
VTX_OLLAMA=0
# Конкретные модели провайдеров (по умолчанию — разумные, менять не обязательно).
#VTX_NVIDIA_MODEL=deepseek-ai/deepseek-v4-flash-0731
#VTX_GEMINI_MODEL=gemini-3.1-flash-lite
#VTX_GROQ_MODEL=llama-3.3-70b-versatile
# NVIDIA: потолок ожидания ответа и пауза между кусками потока (сек).
#VTX_NVIDIA_TIMEOUT=420
#VTX_NVIDIA_CHUNK_TIMEOUT=120

# --- Пороги качества протокола ---------------------------------------------
# Меньше этого числа слов речи — протокол не собирается вовсе (пустая запись).
#VTX_MIN_SPEECH_WORDS=40
# Меньше этого — собирается, но с пометкой «встреча, похоже, не состоялась».
#VTX_THIN_SPEECH_WORDS=300
# Сколько слов в строке чата ещё считается командой, а не фразой.
#VTX_CHAT_STOP_MAX_TOKENS=6

# --- Прочее -----------------------------------------------------------------
#VTX_MAX_UPLOAD_MB=2048
#VTX_DEVICE=cpu
#VTX_VAD=1

# ============================================================================
# Остальные переменные. Раньше их не было в этом файле: часть настроек
# существовала только в коде, и узнать про них можно было лишь чтением
# исходников. Значения справа — умолчания.
# ============================================================================

# --- Пути, логи, подготовка при старте --------------------------------------
# Куда класть данные (загрузки, результаты, записи, файловое хранилище).
#VTX_DATA_DIR=./data
# Уровень логов приложения: DEBUG | INFO | WARNING | ERROR.
#VTX_LOG_LEVEL=INFO
# Скачивать модель распознавания заранее, в фоне (0 — не скачивать вовсе).
#VTX_AUTO_SETUP=1
# Что именно предзагружать: 1 — рабочую модель, all — все, 0/none — ничего.
#VTX_PRELOAD_MODELS=1

# --- Модели по умолчанию у платных провайдеров ------------------------------
#VTX_ANALYSIS_MODEL=claude-sonnet-4-6
#VTX_YANDEX_MODEL=yandexgpt/latest
#VTX_GIGACHAT_MODEL=GigaChat
# Корневой сертификат Минцифры для GigaChat. Без него TLS-проверка отключается,
# и ключ уходит по непроверенному соединению — приложение об этом предупреждает.
#VTX_GIGACHAT_CA=/usr/local/share/ca-certificates/russian_trusted_root_ca.crt

# --- Лимиты и ожидание ключей -----------------------------------------------
# Бюджет токенов в минуту для Groq (для расчёта пауз между запросами).
#VTX_GROQ_TPM=12000
# Сколько ждать освобождения ключа при упоре в лимит: один раз и суммарно.
#VTX_KEY_WAIT_SEC=90
#VTX_KEY_TOTAL_WAIT_SEC=300

# --- NVIDIA NIM --------------------------------------------------------------
# Потоковый режим (SSE). Выключать не стоит: без него длинная встреча упирается
# в таймаут шлюза и возвращает 504.
#VTX_NVIDIA_STREAM=1
# Перебор моделей по ключу: сколько проверять, пауза между запросами (общий
# лимит ~40 запросов в минуту на всех) и на сколько кэшировать результат.
#VTX_NVIDIA_PROBE_MAX=30
#VTX_NVIDIA_PROBE_PAUSE=2
#VTX_NVIDIA_CACHE_TTL=604800

# --- Сборка протокола --------------------------------------------------------
# Сколько раз пересобирать тему, если она вышла пустой.
#VTX_MAX_TOPIC_REGENS=6
# Насколько похожими должны быть темы, чтобы слиться в одну (0..1).
#VTX_TOPIC_MERGE_SIM=0.72
# Учитывать ли предыдущую встречу как контекст.
#VTX_CONDITION_PREV=0
# Коэффициент оценки «сэкономлено на протоколах» в метриках.
#VTX_MINUTES_COEFF=0.5

# --- Запись встреч -----------------------------------------------------------
# Номер первого экрана Xvfb; слоты занимают :99, :100, :101, …
#VTX_DISPLAY_BASE=99
# Запасной приёмник звука (реальная запись всегда берёт монитор своего слота).
#VTX_PULSE_MONITOR=meet0.monitor
# Сколько ждать выгрузку записи в облако целиком, секунд.
#VTX_UPLOAD_TIMEOUT=1800

# --- Определение говорящего по видео ----------------------------------------
# Пороги распознавания зелёной подсветки активного участника. Трогать их нужно
# только если Телемост поменяет оформление; калибруются по реальной записи.
#VTX_SPEAKER_SAMPLE_SEC=1.5        # шаг между кадрами, с
#VTX_SPEAKER_MAX_FRAMES=3000       # потолок числа кадров на запись
#VTX_SPEAKER_G_MIN=110             # минимум зелёного в рамке
#VTX_SPEAKER_R_MAX=185             # максимум красного
#VTX_SPEAKER_B_MAX=185             # максимум синего
#VTX_SPEAKER_GR_DIFF=35            # насколько зелёный выше красного
#VTX_SPEAKER_GB_DIFF=20            # насколько зелёный выше синего
#VTX_SPEAKER_EDGE_MIN=0.35         # доля периметра, занятая рамкой
#VTX_SPEAKER_FILL_MAX=0.45         # максимум заливки внутри рамки
#VTX_SPEAKER_MIN_TILE=0.10         # минимальная ширина плитки, доля кадра
#VTX_SPEAKER_MIN_TILE_AREA=0.02    # минимальная площадь плитки, доля кадра
#VTX_SPEAKER_NAME_BAND=0.26        # высота полосы с именем, доля плитки
#VTX_SPEAKER_TOP_STRIP=0.30        # верхняя полоса при демонстрации экрана
#VTX_PARTICIPANT_MIN_SHARE=0.34    # доля кадров, чтобы имя попало в участники
