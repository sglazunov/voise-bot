# HTTPS-прокси перед приложением. Caddy сам получает сертификат Let's Encrypt
# при первом запуске и продлевает его в фоне — certbot и cron не нужны.
#
# Домен берётся из переменной DOMAIN в .env. Пока она пустая, сервис caddy не
# поднимается (профиль compose), и приложение работает по http://IP:8000.
#
# Конфиг намеренно минимальный: каждая лишняя директива — ещё одна причина, по
# которой прокси может не подняться и увести сайт в офлайн.
{
	# Почта для Let's Encrypt: туда придёт письмо, если продление сломается.
	email {$ACME_EMAIL:admin@example.com}
}

{$DOMAIN} {
	# Приложение слушает внутри сети compose; наружу торчит только Caddy.
	# X-Forwarded-For и X-Forwarded-Proto reverse_proxy проставляет сам —
	# приложению нужен лишь VTX_TRUST_PROXY=1, чтобы им доверять.
	reverse_proxy app:8000

	# Записи встреч и загружаемые файлы большие — снимаем лимит на тело запроса.
	request_body {
		max_size 4GB
	}

	encode gzip
}
