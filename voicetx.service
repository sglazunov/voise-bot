[Unit]
Description=Voice Transcriber (faster-whisper web service)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# --- EDIT these two lines to match your setup ---
User=admin1
WorkingDirectory=/home/admin1/voice-transcriber
# ------------------------------------------------
Environment=VTX_MODEL=small
Environment=VTX_COMPUTE_TYPE=int8
Environment=VTX_CPU_THREADS=4
Environment=VTX_BEAM_SIZE=1
# Diarization stays off until a RAM upgrade:
Environment=VTX_DIARIZATION=0
# Cap memory so a runaway job can't freeze the whole laptop (needs cgroups v2):
MemoryMax=3200M
ExecStart=/home/admin1/voice-transcriber/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
